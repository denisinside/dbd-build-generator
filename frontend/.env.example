# Copy to .env.local for local development.

# Backend API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend API as seen from the Next.js server. Only needed when the API is
# reachable on a different (internal) hostname — inside Docker, for example.
# API_URL=http://api:8000

# Public origin of this frontend. Used to build absolute Open Graph URLs for
# shared build links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
