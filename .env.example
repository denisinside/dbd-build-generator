# Copy to .env and fill in the secrets. Never commit .env.

# --- Database ---
MONGO_URI=mongodb://localhost:27017/

# --- API ---
# Comma-separated browser origins allowed to call the API. Add your deployed
# frontend origin here, otherwise every request from it fails CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Models (OpenRouter is used for both chat and embeddings) ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna

# --- Generation limits ---
# Builds per client IP per hour. 0 disables the cap.
GENERATE_LIMIT_PER_HOUR=5
# Builds running at once. Each one holds a worker thread for minutes, so this
# is what keeps a burst from starving the rest of the API.
GENERATE_CONCURRENCY=3
# Wall-clock budget for one build, across research and every retry.
BUILD_DEADLINE_SECONDS=240
# Per-call model timeout, and the research loop's step ceiling.
LLM_TIMEOUT_SECONDS=90
RESEARCH_MAX_STEPS=12

# --- Web search (optional; search_web_meta is skipped without it) ---
TAVILY_API_KEY=

# --- Tracing (optional). Enabling this sends every user prompt to LangSmith. ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=DBD Builder

# --- Wiki scraping politeness, in seconds between requests ---
WIKI_PAGE_DELAY=0.75
WIKI_MEDIA_DELAY=0.15
